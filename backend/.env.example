# Application
PORT=5000
NODE_ENV=development
APP_NAME="CASA API Gateway"
APP_PREFIX="api/v1"

# CORS & Frontend URLs
# (In production set to your live domain, e.g. https://casa-real-estate-mocha.vercel.app)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database Configuration (MongoDB Atlas / Local fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/casa_real_estate
MONGODB_DB_NAME=casa_real_estate

# Authentication & JWT Secrets (Placeholders only - replace in deployment)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET_SALT=your_otp_hashing_pepper_secret_key

# SMS / OTP Gateway Configuration (Legacy Fallback)
SMS_PROVIDER=mock
ENABLE_MOCK_SMS=false
MOCK_OTP_ALLOWED_MOBILE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=CASARE

# Redis (Optional in local dev)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/casa

# Transactional Email / SMTP Configuration
# (EMAIL_VERIFICATION_URL and PASSWORD_RESET_URL are optional overrides;
#  when omitted, they automatically derive from FRONTEND_URL and NODE_ENV)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="CASA Real Estate" <no-reply@casarealestate.com>
EMAIL_VERIFICATION_URL=
PASSWORD_RESET_URL=
EMAIL_DEV_LOG=true

