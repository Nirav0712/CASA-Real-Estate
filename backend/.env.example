# Application
PORT=5000
NODE_ENV=development
APP_NAME="CASA API Gateway"
APP_PREFIX="api/v1"

# CORS & Frontend URLs
# In local development (NODE_ENV=development): defaults to http://localhost:3000 and http://localhost:3001
# In production (NODE_ENV=production): defaults to https://casa-real-estate-mocha.vercel.app and https://casa-real-estate-ocih.vercel.app
# Note: In production mode, localhost/127.0.0.1 values are automatically rejected and replaced with production URLs.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database Configuration (MongoDB Atlas / Local fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/casa_real_estate
MONGODB_DB_NAME=casa_real_estate

# Authentication & JWT Secrets (Placeholders only - replace in deployment)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET_SALT=your_otp_hashing_pepper_secret_key

# SMS / OTP Gateway Configuration (Legacy Fallback)
SMS_PROVIDER=mock
ENABLE_MOCK_SMS=false
MOCK_OTP_ALLOWED_MOBILE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=CASARE

# Redis (Optional in local dev)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/casa

# Transactional Email / SMTP Configuration
# In development, leave EMAIL_VERIFICATION_URL and PASSWORD_RESET_URL blank to automatically derive from FRONTEND_URL.
# In production, links automatically default to https://casa-real-estate-mocha.vercel.app.
# Localhost overrides in .env are strictly ignored in production mode to protect mobile and remote users from connection errors.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="CASA Real Estate" <no-reply@casarealestate.com>
EMAIL_VERIFICATION_URL=
PASSWORD_RESET_URL=
EMAIL_DEV_LOG=true

