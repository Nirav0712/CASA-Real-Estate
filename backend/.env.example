# Application
PORT=5000
NODE_ENV=development
APP_NAME="CASA API Gateway"
APP_PREFIX="api/v1"

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database Configuration (MongoDB Atlas / Local fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/casa_real_estate
MONGODB_DB_NAME=casa_real_estate

# Authentication & JWT Secrets (Placeholders only - replace in deployment)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_HASH_SECRET=your_otp_hashing_pepper_secret_key

# Redis (Optional in local dev)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/casa
